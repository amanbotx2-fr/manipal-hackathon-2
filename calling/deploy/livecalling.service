[Unit]
Description=LiveCalling signaling server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=livecalling
WorkingDirectory=/opt/LiveCalling/server
EnvironmentFile=/etc/livecalling.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
